rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // CCTV footage requests collection
    match /cctv_requests/{requestId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
        && request.resource.data.no is string
        && request.resource.data.name is string;
      allow delete: if true;
    }

    // Registered user accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.u is string
        && request.resource.data.role in ['admin', 'full', 'limited'];
    }

    // Application configuration settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
